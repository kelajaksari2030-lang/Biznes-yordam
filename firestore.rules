rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Connection probe test document
    match /test/connection {
      allow read: if true;
    }

    // User document rules (Profile, Subscription & Subcollections)
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Users cannot list other users

      // On registration, users can create their own profile with 'free' plan only
      // Pro and Ultra plans can ONLY be provisioned by a trusted server/admin
      allow create: if isOwner(userId)
        && incoming().uid == userId
        && incoming().currentPlan == 'free';

      // Profile updates cannot alter currentPlan, subscriptionStatus, planExpiresAt, or createdAt
      allow update: if isOwner(userId)
        && incoming().uid == userId
        && (!('currentPlan' in existing()) || incoming().currentPlan == existing().currentPlan)
        && (!('subscriptionStatus' in existing()) || incoming().subscriptionStatus == existing().subscriptionStatus)
        && !incoming().diff(existing()).affectedKeys().hasAny(['currentPlan', 'subscriptionStatus', 'planExpiresAt', 'createdAt']);

      allow delete: if false;

      // Daily Usage Tracking for ad generations (strictly authoritative backend / Admin SDK only)
      match /usage/{dateId} {
        allow get, list: if isOwner(userId);
        allow write: if false; // Disallow all client writes. Quota is updated only via backend transaction.
      }

      // User's saved Ad drafts
      match /adDrafts/{draftId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && incoming().userId == userId
          && incoming().content is string && incoming().content.size() <= 10000;
        allow delete: if isOwner(userId);
      }

      // User's saved calculations
      match /calculations/{calcId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && incoming().userId == userId;
        allow delete: if isOwner(userId);
      }

      // User's custom reply templates
      match /customTemplates/{templateId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && incoming().userId == userId;
        allow delete: if isOwner(userId);
      }
    }

    // Orders (Access restricted to owner)
    match /orders/{orderId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
