rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admin authorization is granted only by a server-assigned Firebase custom claim.
    // Never use email claims as an authorization mechanism.
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Connection probe test document (SEC-02: restricted to authenticated users)
    match /test/connection {
      allow read: if isSignedIn();
    }

    // User document rules (Profile, Subscription & Subcollections)
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Users cannot list other users

      allow create: if isOwner(userId)
        && incoming().uid == userId
        && (incoming().currentPlan == 'free' || isAdmin());

      allow update: if isOwner(userId)
        && incoming().uid == userId
        && (!('currentPlan' in existing()) || incoming().currentPlan == existing().currentPlan || isAdmin())
        && (!('subscriptionStatus' in existing()) || incoming().subscriptionStatus == existing().subscriptionStatus || isAdmin())
        && (!incoming().diff(existing()).affectedKeys().hasAny(['currentPlan', 'subscriptionStatus', 'planExpiresAt', 'createdAt']) || isAdmin());

      allow delete: if false;

      // Usage tracking
      match /usage/{dateId} {
        allow get, list: if isOwner(userId);
        allow write: if false;
      }

      // Ad drafts
      match /adDrafts/{draftId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && incoming().userId == userId
          && incoming().content is string && incoming().content.size() <= 10000;
        allow delete: if isOwner(userId);
      }

      // Calculations
      match /calculations/{calcId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && incoming().userId == userId;
        allow delete: if isOwner(userId);
      }

      // Custom reply templates
      match /customTemplates/{templateId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && incoming().userId == userId;
        allow delete: if isOwner(userId);
      }

      // Business profile
      match /businessProfile/{docId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && incoming().userId == userId;
        allow delete: if isOwner(userId);
      }

      // CRM Customers
      match /customers/{customerId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && incoming().userId == userId;
        allow delete: if isOwner(userId);
      }

      // Inventory Products
      match /products/{productId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && incoming().userId == userId;
        allow delete: if isOwner(userId);
      }

      // Sales Orders
      match /orders/{orderId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && incoming().userId == userId
          && incoming().status in ['draft', 'confirmed']
          && incoming().paymentStatus in ['unpaid', 'partially_paid', 'paid']
          && (!('paidAmount' in incoming()) || (incoming().paidAmount is number && incoming().paidAmount >= 0))
          && incoming().stockDeducted is bool
          && incoming().totalAmount is number && incoming().totalAmount >= 0
          && incoming().totalCost is number && incoming().totalCost >= 0
          && incoming().items is list;
        allow update: if isOwner(userId)
          && incoming().userId == userId
          && incoming().status in ['draft', 'confirmed', 'delivered', 'cancelled']
          && incoming().paymentStatus in ['unpaid', 'partially_paid', 'paid']
          && (!('paidAmount' in incoming()) || (incoming().paidAmount is number && incoming().paidAmount >= 0))
          && incoming().stockDeducted is bool
          && incoming().totalAmount is number && incoming().totalAmount >= 0
          && incoming().totalCost is number && incoming().totalCost >= 0;
        allow delete: if isOwner(userId)
          && (!('stockDeducted' in existing()) || existing().stockDeducted == false);
      }

      // Financial Transactions (Expenses & Ledger - Strictly isolated per user)
      match /transactions/{transactionId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && incoming().userId == userId
          && incoming().type in ['income', 'expense']
          && incoming().category in ['ijara', 'reklama', 'transport', 'ish_haqi', 'mahsulot_xaridi', 'kommunal', 'boshqa', 'sales', 'tax', 'other']
          && incoming().amount is number && incoming().amount > 0
          && incoming().date is string && incoming().date.size() == 10;
        allow update: if isOwner(userId)
          && incoming().userId == userId
          && incoming().type in ['income', 'expense']
          && incoming().category in ['ijara', 'reklama', 'transport', 'ish_haqi', 'mahsulot_xaridi', 'kommunal', 'boshqa', 'sales', 'tax', 'other']
          && incoming().amount is number && incoming().amount > 0
          && incoming().date is string && incoming().date.size() == 10;
        allow delete: if isOwner(userId);
      }

      // NEW MODULE 1: Suppliers & Purchase Orders
      match /suppliers/{supplierId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && incoming().userId == userId;
        allow delete: if isOwner(userId);
      }

      match /purchaseOrders/{poId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && incoming().userId == userId;
        allow delete: if isOwner(userId);
      }

      // NEW MODULE 2: Staff & Shifts
      match /staff/{staffId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && incoming().userId == userId;
        allow delete: if isOwner(userId);
      }

      match /shifts/{shiftId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && incoming().userId == userId;
        allow delete: if isOwner(userId);
      }

      // NEW MODULE 3: Telegram Config
      match /telegramConfig/{configId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // NEW MODULE 4: Loyalty Ledger
      match /loyaltyLedger/{ledgerId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && incoming().userId == userId;
        allow delete: if isOwner(userId);
      }

      // NEW MODULE 5: Multi-Branch & Warehouses & Transfers
      match /branches/{branchId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && incoming().userId == userId;
        allow delete: if isOwner(userId);
      }

      match /warehouses/{warehouseId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && incoming().userId == userId;
        allow delete: if isOwner(userId);
      }

      match /transfers/{transferId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && incoming().userId == userId;
        allow delete: if isOwner(userId);
      }

      // SETTINGS
      match /settings/{settingsId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
    }

    match /orders/{orderId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /telegramLinkCodes/{code} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "pending"
        && code.matches("[A-Z0-9]{8}");
      allow get: if request.auth != null && resource.data.userId == request.auth.uid;
      allow list, update, delete: if false;
    }

    match /telegramChats/{chatId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
  }
}

