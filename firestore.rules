rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Connection probe test document
    match /test/connection {
      allow read: if true;
    }

    // User document rules (Profile, Subscription & Subcollections)
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Users cannot list other users

      // On registration, users can create their own profile with 'free' plan (Admin email kelajaksari2030@gmail.com is allowed 'ultra' plan)
      // Pro and Ultra plans for standard users can ONLY be provisioned by a trusted server/admin
      allow create: if isOwner(userId)
        && incoming().uid == userId
        && (incoming().currentPlan == 'free' || (request.auth.token.email != null && request.auth.token.email.lower() == 'kelajaksari2030@gmail.com'));

      // Profile updates cannot alter currentPlan, subscriptionStatus, planExpiresAt, or createdAt unless authenticated as Admin
      allow update: if isOwner(userId)
        && incoming().uid == userId
        && (!('currentPlan' in existing()) || incoming().currentPlan == existing().currentPlan || (request.auth.token.email != null && request.auth.token.email.lower() == 'kelajaksari2030@gmail.com'))
        && (!('subscriptionStatus' in existing()) || incoming().subscriptionStatus == existing().subscriptionStatus || (request.auth.token.email != null && request.auth.token.email.lower() == 'kelajaksari2030@gmail.com'))
        && (!incoming().diff(existing()).affectedKeys().hasAny(['currentPlan', 'subscriptionStatus', 'planExpiresAt', 'createdAt']) || (request.auth.token.email != null && request.auth.token.email.lower() == 'kelajaksari2030@gmail.com'));

      allow delete: if false;

      // Daily Usage Tracking for ad generations (strictly authoritative backend / Admin SDK only)
      match /usage/{dateId} {
        allow get, list: if isOwner(userId);
        allow write: if false; // Disallow all client writes. Quota is updated only via backend transaction.
      }

      // User's saved Ad drafts
      match /adDrafts/{draftId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && incoming().userId == userId
          && incoming().content is string && incoming().content.size() <= 10000;
        allow delete: if isOwner(userId);
      }

      // User's saved calculations
      match /calculations/{calcId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && incoming().userId == userId;
        allow delete: if isOwner(userId);
      }

      // User's custom reply templates
      match /customTemplates/{templateId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && incoming().userId == userId;
        allow delete: if isOwner(userId);
      }

      // User's unified business profile
      match /businessProfile/{docId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && incoming().userId == userId;
        allow delete: if isOwner(userId);
      }

      // CRM Customers (Strictly isolated per user)
      match /customers/{customerId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && incoming().userId == userId;
        allow delete: if isOwner(userId);
      }

      // Warehouse Inventory Products (Strictly isolated per user)
      match /products/{productId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && incoming().userId == userId;
        allow delete: if isOwner(userId);
      }

      // Sales Orders (Strictly isolated per user with schema invariants)
      match /orders/{orderId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && incoming().userId == userId
          && incoming().status in ['draft', 'confirmed']
          && incoming().paymentStatus in ['unpaid', 'partially_paid', 'paid']
          && (!('paidAmount' in incoming()) || (incoming().paidAmount is number && incoming().paidAmount >= 0))
          && incoming().stockDeducted is bool
          && incoming().totalAmount is number && incoming().totalAmount >= 0
          && incoming().totalCost is number && incoming().totalCost >= 0
          && incoming().items is list;
        allow update: if isOwner(userId)
          && incoming().userId == userId
          && incoming().status in ['draft', 'confirmed', 'delivered', 'cancelled']
          && incoming().paymentStatus in ['unpaid', 'partially_paid', 'paid']
          && (!('paidAmount' in incoming()) || (incoming().paidAmount is number && incoming().paidAmount >= 0))
          && incoming().stockDeducted is bool
          && incoming().totalAmount is number && incoming().totalAmount >= 0
          && incoming().totalCost is number && incoming().totalCost >= 0;
        allow delete: if isOwner(userId)
          && (!('stockDeducted' in existing()) || existing().stockDeducted == false);
      }

      // Financial Transactions (Expenses & Ledger - Strictly isolated per user)
      match /transactions/{transactionId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && incoming().userId == userId
          && incoming().type in ['income', 'expense']
          && incoming().category in ['ijara', 'reklama', 'transport', 'ish_haqi', 'mahsulot_xaridi', 'kommunal', 'boshqa', 'sales', 'tax', 'other']
          && incoming().amount is number && incoming().amount > 0
          && incoming().date is string && incoming().date.size() == 10;
        allow update: if isOwner(userId)
          && incoming().userId == userId
          && incoming().type in ['income', 'expense']
          && incoming().category in ['ijara', 'reklama', 'transport', 'ish_haqi', 'mahsulot_xaridi', 'kommunal', 'boshqa', 'sales', 'tax', 'other']
          && incoming().amount is number && incoming().amount > 0
          && incoming().date is string && incoming().date.size() == 10;
        allow delete: if isOwner(userId);
      }
    }

    // Orders (Access restricted to owner)
    match /orders/{orderId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
