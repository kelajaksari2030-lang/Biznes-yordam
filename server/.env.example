# ========================================================
# BiznesYordam Backend - Render Environment Variables
# Free Tier Deployment Configuration
# ========================================================

# Server Port (Render sets this automatically; default 10000)
PORT=10000

# Node Environment
NODE_ENV=production

# Allowed CORS Origins (Your Frontend URL, e.g. https://your-app.web.app or *)
CORS_ORIGIN=*

# Firebase Project Configuration
FIREBASE_PROJECT_ID=gen-lang-client-0498548617

# Provisioned Named Firestore Database ID (CRITICAL: Do not use default)
FIRESTORE_DATABASE_ID=ai-studio-biznesyordam-e0d6389f-9af4-4469-a3e0-1826035a54fd

# --------------------------------------------------------
# Firebase Admin Credentials (Option A - Recommended for Render):
# Paste the entire JSON service account key string into one secret variable.
# --------------------------------------------------------
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"gen-lang-client-0498548617",...}

# --------------------------------------------------------
# Firebase Admin Credentials (Option B - Split variables):
# Easier when copying individual fields on a mobile phone:
# --------------------------------------------------------
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@gen-lang-client-0498548617.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Optional server-side admin UID allowlist (comma-separated Firebase Auth UIDs).
# This grants backend-only admin quota/simulation access; Firestore admin writes
# still require a server-assigned Firebase custom claim: admin=true.
# ADMIN_UIDS=your-firebase-auth-uid
