{
  "entities": {
    "User": {
      "title": "User",
      "description": "Foydalanuvchi hisobi, obuna holati va ma'lumotlari",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "currentPlan": { "type": "string", "enum": ["free", "pro", "ultra"] },
        "subscriptionStatus": { "type": "string", "enum": ["active", "none", "pending", "expired"] },
        "planExpiresAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "email", "currentPlan"]
    },
    "BusinessProfile": {
      "title": "BusinessProfile",
      "description": "Foydalanuvchining yagona biznes profili (kompaniya, auditoriya, kanallar, valyuta)",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "companyName": { "type": "string", "maxLength": 150 },
        "category": { "type": "string", "maxLength": 128 },
        "targetAudience": { "type": "string", "maxLength": 500 },
        "mainSalesChannels": { "type": "array", "items": { "type": "string" } },
        "currency": { "type": "string", "enum": ["UZS", "USD"] },
        "cityOrRegion": { "type": "string", "maxLength": 128 },
        "description": { "type": "string", "maxLength": 1000 },
        "phone": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["userId", "companyName", "category", "targetAudience"]
    },
    "Customer": {
      "title": "Customer",
      "description": "CRM tizimidagi mijoz yozuvi, kontaktlari va statusi",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 64 },
        "telegramUsername": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["lead", "active", "vip", "inactive"] },
        "totalOrdersCount": { "type": "number" },
        "totalSpent": { "type": "number" },
        "loyaltyBalanceUZS": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "name", "phone"]
    },
    "Product": {
      "title": "Product",
      "description": "Mahsulotlar omboridagi tovar, uning qoldig'i, tannarxi va sotuv narxi",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 250 },
        "sku": { "type": "string", "maxLength": 100 },
        "purchaseCost": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "quantity": { "type": "number" },
        "unit": { "type": "string", "maxLength": 50 },
        "minStockAlert": { "type": "number" },
        "category": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "name", "purchaseCost", "sellingPrice", "quantity"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Ta'minotchi kishi yoki kompaniya yozuvi",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 64 },
        "balancePayable": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "name", "phone"]
    },
    "PurchaseOrder": {
      "title": "PurchaseOrder",
      "description": "Xomashyo va tovarlar xarid buyurtmasi",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "poNumber": { "type": "string", "maxLength": 64 },
        "supplierId": { "type": "string", "maxLength": 128 },
        "supplierName": { "type": "string", "maxLength": 200 },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["draft", "ordered", "received", "cancelled"] },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "poNumber", "supplierId", "totalAmount"]
    },
    "StaffMember": {
      "title": "StaffMember",
      "description": "Xodim yozuvi va rol huquqlari",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "role": { "type": "string", "enum": ["admin", "manager", "cashier", "accountant"] },
        "commissionRatePercent": { "type": "number" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "name", "role"]
    },
    "StaffShift": {
      "title": "StaffShift",
      "description": "Smena va kassa topshirish yozuvi",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "staffId": { "type": "string", "maxLength": 128 },
        "staffName": { "type": "string", "maxLength": 200 },
        "initialCash": { "type": "number" },
        "status": { "type": "string", "enum": ["open", "closed"] },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "staffId", "status"]
    },
    "StockTransfer": {
      "title": "StockTransfer",
      "description": "Omborlararo tovarlar o'tkazish yozuvi",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "transferNumber": { "type": "string", "maxLength": 64 },
        "sourceWarehouseId": { "type": "string", "maxLength": 128 },
        "destWarehouseId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["pending", "in_transit", "completed", "cancelled"] },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "transferNumber", "sourceWarehouseId", "destWarehouseId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Foydalanuvchi shaxsiy profili va obuna holati"
    },
    "/users/{userId}/businessProfile/{docId}": {
      "schema": "BusinessProfile",
      "description": "Yagona biznes profili"
    },
    "/users/{userId}/customers/{customerId}": {
      "schema": "Customer",
      "description": "CRM mijozlar bazasi"
    },
    "/users/{userId}/products/{productId}": {
      "schema": "Product",
      "description": "Mahsulotlar ombori"
    },
    "/users/{userId}/suppliers/{supplierId}": {
      "schema": "Supplier",
      "description": "Ta'minotchilar yozuvi"
    },
    "/users/{userId}/purchaseOrders/{poId}": {
      "schema": "PurchaseOrder",
      "description": "Xarid buyurtmalari"
    },
    "/users/{userId}/staff/{staffId}": {
      "schema": "StaffMember",
      "description": "Xodimlar va rollar"
    },
    "/users/{userId}/shifts/{shiftId}": {
      "schema": "StaffShift",
      "description": "Kassa smenalari"
    },
    "/users/{userId}/transfers/{transferId}": {
      "schema": "StockTransfer",
      "description": "Omborlararo transferlar"
    }
  }
}
