{
  "entities": {
    "User": {
      "title": "User",
      "description": "Foydalanuvchi hisobi, obuna holati va ma'lumotlari",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "currentPlan": { "type": "string", "enum": ["free", "pro", "ultra"] },
        "subscriptionStatus": { "type": "string", "enum": ["active", "none", "pending", "expired"] },
        "planExpiresAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "email", "currentPlan"]
    },
    "DailyUsage": {
      "title": "DailyUsage",
      "description": "Foydalanuvchining kunlik reklama matnlari generatsiyasi hisobi",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 32 },
        "adCount": { "type": "number" },
        "lastGeneratedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "date", "adCount"]
    },
    "AdDraft": {
      "title": "AdDraft",
      "description": "Foydalanuvchi tomonidan yaratilgan va saqlangan reklama qoralamasi",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "productName": { "type": "string", "maxLength": 256 },
        "platform": { "type": "string", "enum": ["telegram", "instagram"] },
        "content": { "type": "string", "maxLength": 10000 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "title", "platform", "content"]
    },
    "SavedCalculation": {
      "title": "SavedCalculation",
      "description": "Foydalanuvchi tomonidan saqlangan mahsulot tannarxi va foyda hisob-kitobi",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 256 },
        "date": { "type": "string", "maxLength": 64 },
        "purchaseCost": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "quantity": { "type": "number" },
        "extraCostPerItem": { "type": "number" },
        "fixedCosts": { "type": "number" },
        "netProfit": { "type": "number" },
        "marginPercent": { "type": "number" },
        "markupPercent": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "name", "purchaseCost", "sellingPrice", "netProfit"]
    },
    "CustomTemplate": {
      "title": "CustomTemplate",
      "description": "Foydalanuvchi tomonidan yaratilgan maxsus mijoz javobi shabloni",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "category": { "type": "string", "maxLength": 64 },
        "template": { "type": "string", "maxLength": 5000 },
        "description": { "type": "string", "maxLength": 512 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "title", "category", "template"]
    },
    "BusinessProfile": {
      "title": "BusinessProfile",
      "description": "Foydalanuvchining yagona biznes profili (kompaniya, auditoriya, kanallar, valyuta)",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "companyName": { "type": "string", "maxLength": 150 },
        "category": { "type": "string", "maxLength": 128 },
        "targetAudience": { "type": "string", "maxLength": 500 },
        "mainSalesChannels": { "type": "array", "items": { "type": "string" } },
        "currency": { "type": "string", "enum": ["UZS", "USD"] },
        "cityOrRegion": { "type": "string", "maxLength": 128 },
        "description": { "type": "string", "maxLength": 1000 },
        "phone": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["userId", "companyName", "category", "targetAudience"]
    },
    "Customer": {
      "title": "Customer",
      "description": "CRM tizimidagi mijoz yozuvi, kontaktlari va statusi",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 64 },
        "telegramUsername": { "type": "string", "maxLength": 128 },
        "notes": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "enum": ["yangi", "boglanildi", "muzokara", "xarid_qildi", "yoqotildi"] },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "name", "phone", "status"]
    },
    "Product": {
      "title": "Product",
      "description": "Mahsulotlar omboridagi tovar, uning qoldig'i, tannarxi va sotuv narxi",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 250 },
        "sku": { "type": "string", "maxLength": 100 },
        "purchasePrice": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "quantity": { "type": "number" },
        "unit": { "type": "string", "maxLength": 50 },
        "minStockAlert": { "type": "number" },
        "category": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "name", "purchasePrice", "sellingPrice", "quantity", "unit", "minStockAlert"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Foydalanuvchi shaxsiy profili, obuna holati va sozlamalari"
    },
    "/users/{userId}/usage/{dateId}": {
      "schema": "DailyUsage",
      "description": "Foydalanuvchining ma'lum kungi reklama yaratish ko'rsatkichi"
    },
    "/users/{userId}/adDrafts/{draftId}": {
      "schema": "AdDraft",
      "description": "Foydalanuvchining shaxsiy reklama matnlari qoralamalari"
    },
    "/users/{userId}/calculations/{calcId}": {
      "schema": "SavedCalculation",
      "description": "Foydalanuvchining shaxsiy saqlangan moliyaviy hisobotlari"
    },
    "/users/{userId}/customTemplates/{templateId}": {
      "schema": "CustomTemplate",
      "description": "Foydalanuvchining shaxsiy javob shablonlari"
    },
    "/users/{userId}/businessProfile/{docId}": {
      "schema": "BusinessProfile",
      "description": "Foydalanuvchining yagona biznes profili"
    },
    "/users/{userId}/customers/{customerId}": {
      "schema": "Customer",
      "description": "Foydalanuvchining CRM mijozlari bazasi"
    },
    "/users/{userId}/products/{productId}": {
      "schema": "Product",
      "description": "Foydalanuvchining mahsulotlar ombori va qoldiqlari"
    }
  }
}
